MATCH (a:Vehicle {name: "汽车"}), (b:Component {name: "进气歧管"}) MERGE (a)-[:HAS_COMPONENT {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.625", source_sent: "花形套筒主要用来拆卸花形螺栓头 螺栓,在汽车上主要用于车门安装螺柱或 进气歧管的双头螺柱的拆卸。"}]->(b);
MATCH (a:Vehicle {name: "汽车"}), (b:Component {name: "散热器"}) MERGE (a)-[:HAS_COMPONENT {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.6749999999999999", source_sent: "散热器位于汽车前部，其芯内有许多管道和散热片，通过冷却风\n扇产生的气流及车辆运动产生的气流将冷却液变冷。 散热器盖有一压力阀，其作用是给冷却液加压。\n压力下的冷却液温度可升至100 ℃以上，使得冷\n却液温度和空气温度的温差更大，以改善冷却效\n果。 当散热器压力增加时，压力阀打开，将冷却液\n送至储液罐；当散热器压力降低时，真空阀打开，\n使储液罐放出冷却液。"}]->(b);
MATCH (a:Vehicle {name: "汽车"}), (b:Component {name: "冷却液"}) MERGE (a)-[:HAS_COMPONENT {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.495", source_sent: "散热器位于汽车前部，其芯内有许多管道和散热片，通过冷却风\n扇产生的气流及车辆运动产生的气流将冷却液变冷。 散热器盖有一压力阀，其作用是给冷却液加压。\n压力下的冷却液温度可升至100 ℃以上，使得冷\n却液温度和空气温度的温差更大，以改善冷却效\n果。 当散热器压力增加时，压力阀打开，将冷却液\n送至储液罐；当散热器压力降低时，真空阀打开，\n使储液罐放出冷却液。"}]->(b);
MATCH (a:System {name: "冷却系统"}), (b:Component {name: "冷却液"}) MERGE (a)-[:HAS_COMPONENT {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.6749999999999999", source_sent: "储液罐与散热器相连，以便存储从散热器溢出的冷却液，并防止\n它流到外面。 当散热器中的冷却液温度上升时，多余的冷却液流入\n储液罐；当散热器冷却时，它从储液罐吸取冷却液。 水泵位于气缸体前部，用于冷却系统内冷却液\n的强制循环。 它由驱动带带动。"}]->(b);
MATCH (a:System {name: "燃油系统"}), (b:Component {name: "燃油滤清器"}) MERGE (a)-[:HAS_COMPONENT {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.5499999999999999", source_sent: "（2）\n测\n试\n燃\n油\n压\n力 1）首先释放燃油管路中的压力，然后断开快速连接接\n头，并将燃油压力表连接到燃油管路中。 2）如果发动机能起动，则起动发动机，并使其怠速运\n转，读取燃油压力表读数。 以本田发动机为例，一般为\n270 ～350kPa。 如果发动机不能起动，则打开点火开关，查\n看压力表压力是否上升。\n① 如果压力正常，燃油系统正常；如\n果压力超出规定值，则更换燃油压力调节\n器、燃油滤清器"}]->(b);
