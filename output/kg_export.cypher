MATCH (a:RepairStep {name: "分解"}), (b:Component {name: "气门"}) MERGE (a)-[:AFFECTS {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.69", source_sent: "（2）电子\n气门调\n节系统\n（VALVE\nTRONIC） 1）功用。 VALVETRONIC 由全可变气门行\n程控制装置和可变凸轮轴控制装置（双 VA-\nNOS）构成，可以任意选择进气门关闭时刻。\n①进气门（气门行程和气门\n关闭时刻）通过 VALVETRONIC\n来控制，从而使进气门关闭时燃\n烧室内达到理想的混合气质量。\n② VALVETRONIC 出现故\n障时，系统将气门行程调节至最\n大，并由节"}]->(b);
