MATCH (a:Component {name: "（4）\n燃\n油\n泵\n的\n检\n修"}), (b:Component {name: "燃油泵"}) MERGE (a)-[:AFFECTS {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.58", source_sent: "（4）\n燃\n油\n泵\n的\n检\n修 1）用万用表测量燃油泵两端子之间的电阻。\n以丰田发动机为例，一般为 2 ～\n3Ω，如果不符合规定，则应更换燃油泵。 2）用蓄电池给燃油泵1 号和2 号端子通电，检查燃油\n泵的运行情况。\n如果泵不工作，则更换燃油泵。 通电\n测试必须在 10s 内完成，否则燃油泵线\n圈有烧坏的危险。"}]->(b);
