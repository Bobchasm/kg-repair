MATCH (a:Component {name: "（2）\n主\n要\n部\n件"}), (b:Component {name: "燃油箱"}) MERGE (a)-[:AFFECTS {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.61", source_sent: "（2）\n主\n要\n部\n件 1）功用\n①燃油箱主要存储燃油。\n②燃油泵将燃油从燃油箱抽送到发\n动机。\n③燃油滤清器从燃油中除去杂质。\n④燃油表液位传感器主要监测燃油\n箱内的燃油量。\n⑤燃油压力调节器主要调节燃油压\n力，使其始终保持在最佳水平，从而稳\n定地注入燃油。\n⑥喷油器将燃油喷射到相应气缸的\n进气歧管。\n⑦ 燃油加注口盖盖住燃油箱，且附\n带一个阀使油箱中压力保持不变。 2）燃油箱"}]->(b);
