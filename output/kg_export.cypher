MATCH (a:Component {name: "冷却液"}), (b:Component {name: "散热器"}) MERGE (a)-[:AFFECTS {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.6649999999999999", source_sent: "散热器位于汽车前部，其芯内有许多管道和散热片，通过冷却风\n扇产生的气流及车辆运动产生的气流将冷却液变冷。 散热器盖有一压力阀，其作用是给冷却液加压。\n压力下的冷却液温度可升至100 ℃以上，使得冷\n却液温度和空气温度的温差更大，以改善冷却效\n果。 当散热器压力增加时，压力阀打开，将冷却液\n送至储液罐；当散热器压力降低时，真空阀打开，\n使储液罐放出冷却液。"}]->(b);
MATCH (a:Component {name: "散热器"}), (b:Component {name: "冷却液"}) MERGE (a)-[:AFFECTS {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.625", source_sent: "散热器位于汽车前部，其芯内有许多管道和散热片，通过冷却风\n扇产生的气流及车辆运动产生的气流将冷却液变冷。 散热器盖有一压力阀，其作用是给冷却液加压。\n压力下的冷却液温度可升至100 ℃以上，使得冷\n却液温度和空气温度的温差更大，以改善冷却效\n果。 当散热器压力增加时，压力阀打开，将冷却液\n送至储液罐；当散热器压力降低时，真空阀打开，\n使储液罐放出冷却液。"}]->(b);
MATCH (a:Component {name: "散热器"}), (b:Component {name: "散热器"}) MERGE (a)-[:AFFECTS {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.565", source_sent: "散热器位于汽车前部，其芯内有许多管道和散热片，通过冷却风\n扇产生的气流及车辆运动产生的气流将冷却液变冷。 散热器盖有一压力阀，其作用是给冷却液加压。\n压力下的冷却液温度可升至100 ℃以上，使得冷\n却液温度和空气温度的温差更大，以改善冷却效\n果。 当散热器压力增加时，压力阀打开，将冷却液\n送至储液罐；当散热器压力降低时，真空阀打开，\n使储液罐放出冷却液。"}]->(b);
MATCH (a:Component {name: "冷却液"}), (b:Component {name: "水泵"}) MERGE (a)-[:AFFECTS {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.6749999999999999", source_sent: "储液罐与散热器相连，以便存储从散热器溢出的冷却液，并防止\n它流到外面。 当散热器中的冷却液温度上升时，多余的冷却液流入\n储液罐；当散热器冷却时，它从储液罐吸取冷却液。 水泵位于气缸体前部，用于冷却系统内冷却液\n的强制循环。 它由驱动带带动。"}]->(b);
