MATCH (a:Component {name: "2.\n检\n查"}), (b:Component {name: "气门导管"}) MERGE (a)-[:AFFECTS {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.6", source_sent: "2.\n检\n查 1）使用钢丝刷将燃烧室以及气门导管的积炭清\n理干净。 2）使用精密直尺和塞尺，检测与气缸体接触的表面的\n翘曲情况。\n以丰田发动机为例，一般气缸体侧翘\n曲最大值为0. 05mm。 当翘曲大于最大\n值时，则更换气缸盖。"}]->(b);
