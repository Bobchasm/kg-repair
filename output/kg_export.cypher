MATCH (a:Component {name: "2.\n检\n查"}), (b:Component {name: "活塞"}) MERGE (a)-[:AFFECTS {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.635", source_sent: "2.\n检\n查 1）目视检查活塞表面，主要包括：\n①活塞顶部是否腐蚀。\n②活塞环岸和环槽是否有裂纹、翘曲、磨损和导致\n卡滞的划伤或毛刺。\n③活塞裙部涂层是否严重磨损。\n④活塞裙部是否有裂纹。\n⑤活塞销孔是否磨损、开裂。\n⑥活塞销卡环槽是否有毛刺等。\n1—活塞顶部 2—环岸和环槽\n3—活塞裙部涂层 4—活塞裙部\n5—活塞销孔 6—活塞销卡环槽\n如果发现任何异常情况，则应更\n换活塞。 2）用垫片刮板除去"}]->(b);
