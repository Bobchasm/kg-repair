MATCH (a:Fault {name: "松动"}), (b:Component {name: "散热器"}) MERGE (a)-[:AFFECTS {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.5299999999999999", source_sent: "故障现象 故障原因 故障诊断与排除 发动机过热 (1)水泵故障 (1)更换水泵 (2)节温器卡滞 (2)更换节温器 (3)散热器散热片损坏 (3)尘土堵塞或变形,清洁干净 (4)散热器冷却管堵塞 (4)异物过多(锈蚀、沙土等),更换散热器 (5)风扇护罩损坏或变形 (5)更换风扇护罩 (6)冷却风扇不工作 (6)更换冷却风扇或排除电路故障 (7)发动机冷却液质量差 (7)更换原厂专用冷却液 (8)"}]->(b);
