MATCH (a:Component {name: "火花塞"}), (b:Component {name: "火花塞"}) MERGE (a)-[:AFFECTS {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.57", source_sent: "首先在主燃油管路上连接专用的燃\n油压力表，然后起动发动机检查燃油压力\n是否在规定的范围之内，并且在发动机急\n加速的情况下油压不应该有明显下降的\n趋势，而是略微升高，否则说明燃油供油\n不足。 将火花塞拆下，把压力表的接头接好\n或直接将表堵在拆下的火花塞的孔上。 将\n点火线圈连接线或喷油器的线全部拔掉。\n起动发动机2 ～4s，查看压力表读数，测量\n过程中重复3 次，每次测完后把表里的气\n放掉，取平均值"}]->(b);
MATCH (a:Component {name: "火花塞"}), (b:Component {name: "点火线圈"}) MERGE (a)-[:AFFECTS {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.6499999999999999", source_sent: "首先在主燃油管路上连接专用的燃\n油压力表，然后起动发动机检查燃油压力\n是否在规定的范围之内，并且在发动机急\n加速的情况下油压不应该有明显下降的\n趋势，而是略微升高，否则说明燃油供油\n不足。 将火花塞拆下，把压力表的接头接好\n或直接将表堵在拆下的火花塞的孔上。 将\n点火线圈连接线或喷油器的线全部拔掉。\n起动发动机2 ～4s，查看压力表读数，测量\n过程中重复3 次，每次测完后把表里的气\n放掉，取平均值"}]->(b);
