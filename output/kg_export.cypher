MATCH (a:RepairStep {name: "更换"}), (b:Tool {name: "诊断仪"}) MERGE (a)-[:REQUIRES_TOOL {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.595", source_sent: "9)更换泄漏的燃油管,安装好废气再循环管,并更换了进气歧管密封垫,起动发动 机,从故障诊断仪的数据流中可以看出各项数值均正常,试车后故障彻底排除。"}]->(b);
