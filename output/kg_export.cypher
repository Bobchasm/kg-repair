MATCH (a:Component {name: "（2）\n测\n试\n燃\n油\n压\n力"}), (b:Component {name: "油管"}) MERGE (a)-[:AFFECTS {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.585", source_sent: "（2）\n测\n试\n燃\n油\n压\n力 1）首先释放燃油管路中的压力，然后断开快速连接接\n头，并将燃油压力表连接到燃油管路中。 2）如果发动机能起动，则起动发动机，并使其怠速运\n转，读取燃油压力表读数。 以本田发动机为例，一般为\n270 ～350kPa。 如果发动机不能起动，则打开点火开关，查\n看压力表压力是否上升。\n① 如果压力正常，燃油系统正常；如\n果压力超出规定值，则更换燃油压力调节\n器、燃油滤清器"}]->(b);
