MATCH (a:RepairStep {name: "拆卸"}), (b:Component {name: "散热器"}) MERGE (a)-[:AFFECTS {source_doc: "看图自学汽车维修_发动机分册", confidence: "0.69", source_sent: "4.\n分\n解\n散\n热\n器 1） 使用散热器板钳拆卸散热器。 2） 用橡胶锤子轻轻敲打散热器支架（散热器进水软管或出\n水软管），并拆下散热器。"}]->(b);
