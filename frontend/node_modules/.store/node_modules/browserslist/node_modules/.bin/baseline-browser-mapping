#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="$basedir/G:/LE/kg-repair/frontend/node_modules/.store/baseline-browser-mapping@2.10.28/node_modules"
else
  export NODE_PATH="$NODE_PATH:$basedir/G:/LE/kg-repair/frontend/node_modules/.store/baseline-browser-mapping@2.10.28/node_modules"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../baseline-browser-mapping@2.10.28/node_modules/baseline-browser-mapping/dist/cli.cjs" "$@"
else
  exec node  "$basedir/../../../../../baseline-browser-mapping@2.10.28/node_modules/baseline-browser-mapping/dist/cli.cjs" "$@"
fi
